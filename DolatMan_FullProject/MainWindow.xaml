<Window x:Class="DolatMan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DolatMan | دستیار ورود و مدیریت متقاضیان"
        Width="1480" Height="920" MinWidth="1180" MinHeight="740"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        Background="#F3F6FB" FontFamily="Segoe UI" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#203047"/>
        <SolidColorBrush x:Key="Muted" Color="#7D8AA0"/>
        <SolidColorBrush x:Key="Blue" Color="#2869B2"/>
        <SolidColorBrush x:Key="Line" Color="#E5ECF4"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2869B2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.76"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="#285A96"/>
            <Setter Property="Background" Value="#EAF2FC"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="#A43D46"/>
            <Setter Property="Background" Value="#FCEBED"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#203047"/>
            <Setter Property="Background" Value="#FBFCFE"/>
            <Setter Property="BorderBrush" Value="#DDE6F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="BorderBrush" Value="#E7EDF5"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DDE9FA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavRoot" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavRoot" Property="Background" Value="#315C91"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavRoot" Property="Background" Value="#3D70AD"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E7EDF5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F6"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFD"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeight" Value="42"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="258"/>
        </Grid.ColumnDefinitions>

        <!-- Main content -->
        <Grid Grid.Column="0" Margin="26,22,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,2,20">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="داشبورد اصلی" FontSize="25" FontWeight="Bold" Foreground="#203047"/>
                    <TextBlock x:Name="PageSubtitle" Text="مدیریت پرونده‌ها و راهبری ورود به سامانه دولت من" Foreground="#8290A4" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Left" Background="White" CornerRadius="11" Padding="14,9" BorderBrush="#E7EDF5" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#20A66A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="اطلاعات روی همین رایانه ذخیره می‌شود" Foreground="#63748C" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <!-- Dashboard -->
                <ScrollViewer x:Name="DashboardPanel" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Background="#173E72" Padding="24" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="به DolatMan خوش آمدید" FontSize="23" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="دستیار مدیریت متقاضیان و ورود کنترل‌شده به پنجره ملی خدمات دولت هوشمند" TextWrapping="Wrap" Foreground="#D6E5F8" FontSize="13" Margin="0,10,0,0"/>
                                    <Button Content="شروع کار با Chrome  ←" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,18,0,0" Click="StartChrome_Click" Background="#FFFFFF" Foreground="#1D4D83"/>
                                </StackPanel>
                                <Border Grid.Column="1" Width="94" Height="94" CornerRadius="24" Background="#2B5D98" VerticalAlignment="Center" Margin="22,0,0,0">
                                    <TextBlock Text="DM" FontSize="30" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="پرونده‌های ذخیره‌شده" Foreground="#7B8AA0" FontSize="12"/>
                                    <TextBlock x:Name="ApplicantCountText" Text="۰" Foreground="#245F9F" FontSize="30" FontWeight="Bold" Margin="0,9,0,0"/>
                                    <TextBlock Text="متقاضی" Foreground="#98A4B4" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="5,0">
                                <StackPanel>
                                    <TextBlock Text="فایل‌های خروجی" Foreground="#7B8AA0" FontSize="12"/>
                                    <TextBlock x:Name="ExportCountText" Text="۰" Foreground="#15966A" FontSize="30" FontWeight="Bold" Margin="0,9,0,0"/>
                                    <TextBlock Text="PDF و تصویر" Foreground="#98A4B4" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="وضعیت Chrome" Foreground="#7B8AA0" FontSize="12"/>
                                    <TextBlock x:Name="ChromeStateText" Text="بسته" Foreground="#C07B25" FontSize="25" FontWeight="Bold" Margin="0,11,0,0"/>
                                    <TextBlock Text="مرورگر اختصاصی برنامه" Foreground="#98A4B4" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="مسیر انجام کار" FontSize="16" FontWeight="Bold" Foreground="#26374E"/>
                                <TextBlock Text="۱. ثبت همه متقاضیان  ←  ۲. شروع یک‌باره صف  ←  ۳. ورود کد امنیتی در DolatMan و کد پیامکی در Chrome  ←  ۴. تکمیل و ثبت خودکار فرم  ←  ۵. ذخیره حساب و رفتن به فرد بعدی" TextWrapping="Wrap" Foreground="#6F7F94" FontSize="12" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="نکته امنیتی" FontSize="15" FontWeight="Bold" Foreground="#A56D22"/>
                                <TextBlock Text="کد امنیتی را در پنجره برنامه وارد کنید؛ کد پیامکی را خودتان در Chrome وارد و تأیید کنید. پس از تأیید شروع صف، برنامه فرم را با روش ذخیره‌شده همان پرونده ثبت می‌کند. اگر سامانه خطا بدهد یا داشبورد تأیید نشود، صف برای جلوگیری از ثبت اشتباه متوقف می‌شود و ترکیب شناسه‌ها را خودکار حدس نمی‌زند." TextWrapping="Wrap" Foreground="#76859A" FontSize="12" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Applicants -->
                <Grid x:Name="ApplicantsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="اطلاعات متقاضی" FontSize="16" FontWeight="Bold" Foreground="#24364F" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                    <TextBlock Text="نام و نام خانوادگی *" Foreground="#687990" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox x:Name="NameBox" Style="{StaticResource InputBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="شماره موبایل" Foreground="#687990" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox x:Name="MobileBox" Style="{StaticResource InputBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,0,10">
                                    <TextBlock Text="شناسه یکتا *" Foreground="#687990" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox x:Name="UniqueIdBox" Style="{StaticResource InputBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                                    <TextBlock Text="کد فیدا *" Foreground="#687990" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox x:Name="FidaBox" Style="{StaticResource InputBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="تاریخ تولد (روز/ماه/سال) *" Foreground="#687990" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox x:Name="BirthDateBox" Style="{StaticResource InputBox}" ToolTip="مثال: ۱۵/۰۶/۱۳۷۵"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="8,0,0,10">
                                    <TextBlock Text="ترتیب ورود اطلاعات" Foreground="#687990" FontSize="11" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="MappingCombo" Height="42" FontSize="12" Padding="8" SelectedIndex="0">
                                        <ComboBoxItem Content="شناسه یکتا / کد فیدا"/>
                                        <ComboBoxItem Content="کد فیدا / شناسه یکتا"/>
                                        <ComboBoxItem Content="کد فیدا / کد فیدا"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,0">
                                <Button Content="ذخیره متقاضی" Style="{StaticResource PrimaryButton}" Click="SaveApplicant_Click" Margin="0,0,8,0"/>
                                <Button Content="پاک‌کردن فرم" Style="{StaticResource SecondaryButton}" Click="ClearApplicant_Click" Margin="0,0,8,0"/>
                                <Button Content="آماده‌سازی مجدد پرونده" Style="{StaticResource SecondaryButton}" Click="ResetApplicantQueueStatus_Click" Margin="0,0,8,0" ToolTip="پس از بررسی وضعیت همان پرونده در سامانه، آن را برای اجرای دوباره آماده کنید."/>
                                <Button Content="حذف انتخاب‌شده" Style="{StaticResource DangerButton}" Click="DeleteApplicant_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="فهرست متقاضیان — برای ویرایش روی یک ردیف کلیک کنید" FontSize="14" FontWeight="Bold" Foreground="#26374E" Margin="0,0,0,12"/>
                            <DataGrid x:Name="ApplicantsGrid" SelectionChanged="ApplicantsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="نام متقاضی" Binding="{Binding FullName}" Width="*"/>
                                    <DataGridTextColumn Header="موبایل" Binding="{Binding Mobile}" Width="145"/>
                                    <DataGridTextColumn Header="شناسه یکتا" Binding="{Binding UniqueId}" Width="160"/>
                                    <DataGridTextColumn Header="کد فیدا" Binding="{Binding FidaCode}" Width="150"/>
                                    <DataGridTextColumn Header="تاریخ تولد" Binding="{Binding BirthDate}" Width="125"/>
                                    <DataGridTextColumn Header="روش انتخابی" Binding="{Binding MappingLabel}" Width="170"/>
                                    <DataGridTextColumn Header="وضعیت اجرا" Binding="{Binding QueueStatus}" Width="170"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Browser workflow -->
                <ScrollViewer x:Name="AutomationPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="اجرای مراحل در Chrome" FontSize="17" FontWeight="Bold" Foreground="#24364F"/>
                                <TextBlock Text="یک متقاضی را انتخاب کنید. برنامه Chrome را با پروفایل جداگانه باز می‌کند و اطلاعات پرونده را در فیلدهای قابل شناسایی وارد می‌کند." TextWrapping="Wrap" FontSize="12" Foreground="#7D8AA0" Margin="0,7,0,16"/>
                                <TextBlock Text="صف اجرا تمام متقاضیان ذخیره‌شده را به‌ترتیب پردازش می‌کند. روش ورود هر نفر از پرونده خودش خوانده می‌شود؛ برای تغییر روش، همان پرونده را در بخش مدیریت متقاضیان ویرایش کنید." TextWrapping="Wrap" FontSize="12" Foreground="#2869B2" Background="#EEF5FD" Padding="12"/>
                                <StackPanel Visibility="Collapsed">
                                    <ComboBox x:Name="AutomationApplicantCombo" DisplayMemberPath="FullName"/>
                                    <ComboBox x:Name="AutomationMappingCombo" SelectedIndex="0">
                                        <ComboBoxItem Content="۱) شناسه یکتا / کد فیدا"/>
                                        <ComboBoxItem Content="۲) کد فیدا / شناسه یکتا"/>
                                        <ComboBoxItem Content="۳) کد فیدا / کد فیدا"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="اجرای خودکار فردبه‌فرد" FontSize="16" FontWeight="Bold" Foreground="#24364F" Margin="0,0,0,8"/>
                                <TextBlock Text="فقط یک‌بار شروع را بزنید. برنامه پرونده‌های آماده را به‌ترتیب اجرا می‌کند، موبایل و اطلاعات را وارد می‌کند، کد امنیتی را از شما می‌گیرد و پس از تأیید ورود، فرم را تکمیل، ثبت و خروجی PDF و تصویر را ذخیره می‌کند." TextWrapping="Wrap" Foreground="#77869A" FontSize="12" Margin="0,0,0,14"/>
                                <WrapPanel>
                                    <Button x:Name="StartQueueButton" Content="▶  شروع اجرای همه پرونده‌ها" Style="{StaticResource PrimaryButton}" Click="StartQueue_Click" Margin="0,0,8,8" Padding="22,13"/>
                                    <Button x:Name="StopQueueButton" Content="■  توقف صف" Style="{StaticResource DangerButton}" Click="StopQueue_Click" IsEnabled="False" Margin="0,0,8,8" Padding="18,13"/>
                                </WrapPanel>
                                <TextBlock x:Name="QueueProgressText" Text="صف آماده است؛ متقاضیان را از بخش مدیریت ثبت کنید." Foreground="#2869B2" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <ProgressBar x:Name="QueueProgressBar" Height="8" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="0" Background="#EAF0F7" Foreground="#2869B2"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="فقط دو توقف امنیتی" FontSize="15" FontWeight="Bold" Foreground="#A46B22"/>
                                <TextBlock Text="۱) کد امنیتی تصویری را از Chrome می‌خوانید و در پنجره DolatMan وارد می‌کنید؛ برنامه آن را وارد کرده و ارسال کد را می‌زند. ۲) کد یک‌بارمصرف پیامکی را خودتان در Chrome وارد و تأیید می‌کنید؛ برنامه منتظر می‌ماند و پس از تشخیص ورود موفق، خودکار ادامه می‌دهد. کدها ذخیره نمی‌شوند." TextWrapping="Wrap" Foreground="#77869A" FontSize="12" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="گزارش مرورگر" FontSize="15" FontWeight="Bold" Foreground="#24364F"/>
                                <TextBlock x:Name="BrowserStatusText" Text="Chrome هنوز باز نشده است." Foreground="#6F8096" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"/>
                                <TextBlock x:Name="BrowserUrlText" Text="" Foreground="#2869B2" TextWrapping="Wrap" Margin="0,7,0,0" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Documents -->
                <Border x:Name="DocumentsPanel" Visibility="Collapsed" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="اسناد و فایل‌های خروجی" FontSize="18" FontWeight="Bold" Foreground="#24364F"/>
                        <TextBlock Text="فایل‌های هر متقاضی در Documents\DolatMan\خروجی متقاضیان ذخیره می‌شوند." TextWrapping="Wrap" Foreground="#73839A" Margin="0,8,0,15"/>
                        <Button Content="باز کردن پوشه خروجی‌ها" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="OpenExports_Click"/>
                    </StackPanel>
                </Border>

                <!-- Reports -->
                <Border x:Name="ReportsPanel" Visibility="Collapsed" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="گزارش عملیات" FontSize="18" FontWeight="Bold" Foreground="#24364F" Margin="0,0,0,14"/>
                        <ListBox x:Name="ActivityList" BorderThickness="0" Background="Transparent" Foreground="#5E7088" FontSize="12"/>
                    </DockPanel>
                </Border>

                <!-- Settings -->
                <Border x:Name="SettingsPanel" Visibility="Collapsed" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="تنظیمات و حریم خصوصی" FontSize="18" FontWeight="Bold" Foreground="#24364F"/>
                        <TextBlock Text="اطلاعات متقاضیان با DPAPI ویندوز برای همان حساب کاربری ویندوز رمزگذاری می‌شود. داده‌های پرونده در LocalAppData و اسناد خروجی در Documents ذخیره می‌شوند. از فایل‌های PDF و تصویر مراقبت کنید؛ ممکن است شامل اطلاعات هویتی و QR باشند." TextWrapping="Wrap" Foreground="#73839A" Margin="0,10,0,15"/>
                        <TextBlock Text="کد پیامکی، رمز عبور، کپچا و اطلاعات ورود در برنامه ذخیره نمی‌شوند." Foreground="#21845D" FontWeight="SemiBold" FontSize="12"/>
                        <Button Content="باز کردن پوشه داده‌های برنامه" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="0,18,0,0" Click="OpenDataFolder_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="White" BorderBrush="#E7EDF5" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,14,0,0">
                <TextBlock x:Name="StatusText" Text="آماده به کار" Foreground="#708097" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>

        <!-- Sidebar -->
        <Border Grid.Column="1" Background="#173D70" CornerRadius="20,0,0,20">
            <Grid Margin="17,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="6,0,6,24">
                    <Border Width="54" Height="54" CornerRadius="16" Background="#2B609C" HorizontalAlignment="Right">
                        <TextBlock Text="DM" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="DolatMan" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,14,0,0"/>
                    <TextBlock Text="دستیار مدیریت متقاضیان" Foreground="#BBD0EA" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1">
